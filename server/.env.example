# Copy to server/.env for local work. Never commit the real file.

# Local development defaults
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_pos
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
# COOKIE_MAX_AGE_SECONDS=43200
# TRUST_PROXY=true
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600

# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Production / Render values (set these in the dashboard, not in Git):
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/restaurant_pos?retryWrites=true&w=majority
# CLIENT_ORIGIN=https://your-app.onrender.com
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_MAX_AGE_SECONDS=43200
# TRUST_PROXY=true
