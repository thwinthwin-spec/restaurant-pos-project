{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/restaurant-pos/mongodb-uri",
        "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/restaurant-pos/jwt-secret"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:alias/aws/ssm"
    }
  ]
}
